# ── Local development (.env) ──────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit real secrets.

# Optional locally (defaults to a local-dev secret). REQUIRED in production / Netlify.
SESSION_SECRET=

# Neon Postgres connection string. If omitted locally, API uses an in-memory DB that resets on restart.
# REQUIRED on Netlify for persistent auth/jobs/profile data.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_DATABASE_URL=

# ── AI assessment (any one provider) ──────────────────────────────────────────
# AI_PROVIDER=auto|gemini|openai|openrouter|custom   (default: auto)
# Auto picks the first available key below.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (or any OpenAI-compatible key starting with sk-or-)
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=openai/gpt-4o-mini

# Generic OpenAI-compatible endpoint (Together, Groq, Azure, local LM, etc.)
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=

# Google Gemini (optional — still supported)
# Accepted names (first match wins): GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_CLOUD_API_KEY, VITE_GEMINI_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional: also try Vertex AI publisher endpoints for this project
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# Legacy alias still read by the API:
# VITE_GEMINI_API_KEY=

# Google Sign-In (homeowner + contractor portals)
# Create an OAuth 2.0 Web Client ID: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your app origin, e.g.:
#   http://localhost:5000
#   https://YOUR-SITE.netlify.app
# On Netlify: set VITE_GOOGLE_CLIENT_ID (build-time for the SPA) AND ensure the API
# can read the same value (Netlify env vars are available to Functions at runtime).
VITE_GOOGLE_CLIENT_ID=
# Optional alias — API also accepts GOOGLE_CLIENT_ID if VITE_GOOGLE_CLIENT_ID is unset.
# GOOGLE_CLIENT_ID=

# Password-reset emails via Resend (optional). Without these, reset links are logged server-side only.
# RESEND_API_KEY=
# FROM_EMAIL=FixBridge <onboarding@resend.dev>

# Public site URL used when building password-reset links if Origin header is missing.
# On Netlify set to https://YOUR-SITE.netlify.app
# APP_URL=

# Local API port (server.js). Not used on Netlify.
# API_PORT=3001

# ── Netlify UI checklist (Site settings → Environment variables) ──────────────
# Required:
#   SESSION_SECRET          — long random string for JWT signing
#   NEON_DATABASE_URL       — Neon connection string (persistent DB)
# Build-time (Vite):
#   VITE_GOOGLE_CLIENT_ID   — Google OAuth Web Client ID
# Optional AI (any one):
#   OPENAI_API_KEY / OPENROUTER_API_KEY / AI_API_KEY + AI_BASE_URL / GEMINI_API_KEY
#   AI_PROVIDER, AI_MODEL
# Optional:
#   GOOGLE_CLIENT_ID        — alias for API token verification
#   RESEND_API_KEY          — password-reset emails
#   FROM_EMAIL              — Resend from address
#   APP_URL                 — https://YOUR-SITE.netlify.app
