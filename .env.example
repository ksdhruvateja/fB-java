# ── Local development (.env) ──────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit real secrets.

# Optional locally (defaults to a local-dev secret). REQUIRED in production / Netlify.
SESSION_SECRET=

# Neon Postgres connection string. If omitted locally, API uses an in-memory DB that resets on restart.
# REQUIRED on Netlify for persistent auth/jobs/profile data.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_DATABASE_URL=

# TLS: production always verifies certificates (rejectUnauthorized=true).
# Local-only escape hatch if your environment lacks CA roots (never set in production):
# DB_SSL_REJECT_UNAUTHORIZED=false

# Demo seed users (maria/james/admin). Default true in non-production. Forced OFF in production.
# ENABLE_DEMO_SEED=true

# Primary admin account email (migrates legacy admin emails on startup)
# PRIMARY_ADMIN_EMAIL=admin@fixbridge.com
# Set admin password locally only — never commit PRIMARY_ADMIN_PASSWORD:
# PRIMARY_ADMIN_PASSWORD=

# Allow client-requested payment simulation when Stripe keys exist (local only). Never in production.
# ALLOW_PAYMENT_SIMULATION=true

# NODE_ENV=production — scope to Netlify Functions/Runtime only (NOT Builds).
# Setting NODE_ENV=production in Build scope skips devDependencies and breaks `vite build`.
# Vite sets production mode internally during `npm run build`.

# Netlify scheduled reminders (set in netlify.toml build.environment):
# SERVICE_REMINDER_SCHEDULER_MODE=netlify_scheduled_function_configured

# ── AI assessment (any one provider) ──────────────────────────────────────────
# AI_PROVIDER=auto|gemini|openai|openrouter|custom   (default: auto)
# Auto picks the first available key below.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (or any OpenAI-compatible key starting with sk-or-)
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=openai/gpt-4o-mini

# Generic OpenAI-compatible endpoint (Together, Groq, Azure, local LM, etc.)
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=

# Google Gemini (optional — still supported)
# Accepted names (first match wins): GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_CLOUD_API_KEY, VITE_GEMINI_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional: also try Vertex AI publisher endpoints for this project
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# Legacy alias still read by the API:
# VITE_GEMINI_API_KEY=

# ── Email via Gmail SMTP (password reset + notifications) ─────────────────────
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Branded sender (recipients see this when domain is authorized in your mail provider):
FIXBRIDGE_FROM_EMAIL=support@fixbridge.us
FIXBRIDGE_REPLY_TO_EMAIL=support@fixbridge.us
FIXBRIDGE_FROM_NAME=FixBridge Support
FIXBRIDGE_EMAIL_LOGO_URL=https://fixbridge.netlify.app/fixbridge-logo-lockup.png
# Legacy override (optional):
# FROM_EMAIL=FixBridge Support <support@fixbridge.us>
APP_URL=http://localhost:5000

# Optional comma-separated extra CORS origins (staging, custom domains).
# CORS_ORIGINS=

# Optional JSON body size limit (default 8mb).
# JSON_BODY_LIMIT=8mb

# Optional global API rate limit per IP per 15 minutes (default 400).
# API_RATE_LIMIT_MAX=400

# Local API port (server.js). Not used on Netlify.
# API_PORT=3001

# ── Stripe (required for homeowner payments + contractor Connect on Netlify) ─
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Google OAuth (Sign in with Google — GIS ID token flow)
# GOOGLE_CLIENT_ID = public GIS web client ID only (…apps.googleusercontent.com)
# GOOGLE_CLIENT_SECRET = server-only if ever needed; NEVER put in Vite / VITE_* / public APIs
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Optional frontend fallback if config endpoint unavailable at build time (client ID only):
# VITE_GOOGLE_CLIENT_ID=
# Never create VITE_GOOGLE_CLIENT_SECRET.

# GOOGLE_MAPS_API_KEY=          — server geocoding + scan (Functions)
# VITE_GOOGLE_MAPS_API_KEY=     — Maps JavaScript API (contractor service-area map)
# SLACK_WEBHOOK_URL=
# N8N_WEBHOOK_URL=
# SENTRY_DSN=
# POSTHOG_API_KEY=
# MEDIA_STORAGE_MODE=inline

# Attachment storage (beta uses Neon/database; object storage is a future provider)
# ATTACHMENT_STORAGE_PROVIDER=database
# MAX_ATTACHMENT_SIZE_MB=2.5
# MAX_ATTACHMENTS_PER_MESSAGE=5

# ── USPS Addresses API v3 (server-side only — never expose to Vite/public) ───
# Register at https://developers.usps.com — OAuth client credentials for Addresses API.
# Testing: https://apis-tem.usps.com  Production: https://apis.usps.com
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_API_BASE_URL=https://apis-tem.usps.com
# Optional per-IP address route limit per 15 min (default 120)
# ADDRESS_RATE_LIMIT_MAX=120

# ── Branding overrides (optional) ─────────────────────────────────────────────
# BRAND_PRODUCT_NAME=FixBridge
# BRAND_LEGAL_NAME=FixBridge
# BRAND_SUPPORT_EMAIL=support@fixbridge.example
# BRAND_PRIMARY_COLOR=#FF4D1C

# ── Netlify UI checklist (Site settings → Environment variables) ──────────────
# Required:
#   SESSION_SECRET          — long random string for JWT signing
#   NEON_DATABASE_URL       — Neon connection string (persistent DB)
# Optional AI (any one):
#   OPENAI_API_KEY / OPENROUTER_API_KEY / AI_API_KEY + AI_BASE_URL / GEMINI_API_KEY
#   AI_PROVIDER, AI_MODEL
# Optional payments:
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PUBLISHABLE_KEY
# Email (Gmail SMTP):
#   GMAIL_USER / GMAIL_APP_PASSWORD / FROM_EMAIL
#   APP_URL                 — https://YOUR-SITE.netlify.app
#
# Connected Home reminders (production):
#   SERVICE_REMINDER_CRON_SECRET  — optional, for external cron hitting /api/internal/service-reminders/process
#   ENABLE_SERVICE_REMINDER_POLL=true  — local persistent server.js only (NOT Netlify)
#
# Smoke tests (local, never commit passwords):
#   SMOKE_HOMEOWNER_EMAIL / SMOKE_HOMEOWNER_PASSWORD
#   SMOKE_OTHER_EMAIL / SMOKE_OTHER_PASSWORD
#   SMOKE_PRO_HOMEOWNER_EMAIL / SMOKE_PRO_HOMEOWNER_PASSWORD  (pre-configured Pro; avoids admin MFA)
#   SMOKE_ADMIN_EMAIL / SMOKE_ADMIN_PASSWORD
#   SMOKE_CONTRACTOR_EMAIL / SMOKE_CONTRACTOR_PASSWORD
#   SMOKE_ALLOW_DEMO_FALLBACK=true  (local only — use maria@example.com demo users)
#   API_BASE_URL=http://127.0.0.1:3002   (preferred for isolated local smoke runs)
#   API_BASE=http://localhost:3001       (legacy alias; same purpose)
#   Local tip: API_PORT=3002 node --env-file=.env server.js  then point API_BASE_URL at it
#   (clean in-memory rate-limit counters — test harness practice, not a production change)
#
# Contractor compliance (launch/beta):
#   REQUIRE_FIXBRIDGE_ADDITIONAL_INSURED=false   — FixBridge AI endorsement optional but recommended (default off)
#
# Property timezone (optional server fallback when geocode unavailable):
#   DEFAULT_PROPERTY_TIMEZONE=America/New_York
