# ── Local development (.env) ──────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit real secrets.

# Optional locally (defaults to a local-dev secret). REQUIRED in production / Netlify.
SESSION_SECRET=

# Neon Postgres connection string. If omitted locally, API uses an in-memory DB that resets on restart.
# REQUIRED on Netlify for persistent auth/jobs/profile data.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_DATABASE_URL=

# TLS: production always verifies certificates (rejectUnauthorized=true).
# Local-only escape hatch if your environment lacks CA roots (never set in production):
# DB_SSL_REJECT_UNAUTHORIZED=false

# Demo seed users (maria/james/admin). Default true in non-production. Forced OFF in production.
# ENABLE_DEMO_SEED=true

# Allow client-requested payment simulation when Stripe keys exist (local only). Never in production.
# ALLOW_PAYMENT_SIMULATION=true

# NODE_ENV=production  # set by Netlify; enables TLS verify, disables payment simulation & demo seed

# ── AI assessment (any one provider) ──────────────────────────────────────────
# AI_PROVIDER=auto|gemini|openai|openrouter|custom   (default: auto)
# Auto picks the first available key below.

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (or any OpenAI-compatible key starting with sk-or-)
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=openai/gpt-4o-mini

# Generic OpenAI-compatible endpoint (Together, Groq, Azure, local LM, etc.)
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=

# Google Gemini (optional — still supported)
# Accepted names (first match wins): GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_CLOUD_API_KEY, VITE_GEMINI_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional: also try Vertex AI publisher endpoints for this project
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# Legacy alias still read by the API:
# VITE_GEMINI_API_KEY=

# Auth0 (homeowner + contractor portals — primary auth)
# Dashboard → Applications → Your SPA → Settings:
#   Allowed Callback URLs:  http://localhost:5000, https://YOUR-SITE.netlify.app
#   Allowed Logout URLs:    http://localhost:5000, https://YOUR-SITE.netlify.app
#   Allowed Web Origins:    http://localhost:5000, https://YOUR-SITE.netlify.app
# Application Type: Single Page Application · Token Endpoint Auth Method: none
VITE_AUTH0_DOMAIN=dev-o4m8sw20yo0raj6d.us.auth0.com
VITE_AUTH0_CLIENT_ID=yYj4HFIYcxe5alp2Up1ZyY32HjTlfAjQ
# API reads the same tenant domain at runtime (Netlify env vars are available to Functions).
AUTH0_DOMAIN=dev-o4m8sw20yo0raj6d.us.auth0.com

# Legacy Google Sign-In (optional — superseded by Auth0 when configured)
# Create an OAuth 2.0 Web Client ID: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your app origin, e.g.:
#   http://localhost:5000
#   https://YOUR-SITE.netlify.app
# On Netlify: set VITE_GOOGLE_CLIENT_ID (build-time for the SPA) AND ensure the API
# can read the same value (Netlify env vars are available to Functions at runtime).
VITE_GOOGLE_CLIENT_ID=
# Optional alias — API also accepts GOOGLE_CLIENT_ID if VITE_GOOGLE_CLIENT_ID is unset.
# GOOGLE_CLIENT_ID=

# Sign in with Apple (homeowner + contractor portals)
# Apple Developer → Identifiers → Services ID (Web) for Sign in with Apple.
# Register Return URLs (must match redirect URI), e.g.:
#   http://localhost:5000
#   https://YOUR-SITE.netlify.app
# Domains: same origins as above (without path).
VITE_APPLE_CLIENT_ID=
# Optional — defaults to window.location.origin when unset.
# VITE_APPLE_REDIRECT_URI=http://localhost:5000
# API token verification (same Services ID as VITE_APPLE_CLIENT_ID).
# APPLE_CLIENT_ID=

# Password-reset emails via Resend (optional). Without these, reset links are logged server-side only.
# RESEND_API_KEY=
# FROM_EMAIL=FixBridge <onboarding@resend.dev>

# Public site URL used when building password-reset links if Origin header is missing.
# On Netlify set to https://YOUR-SITE.netlify.app
# Also used as the primary CORS allowlist origin.
# APP_URL=

# Optional comma-separated extra CORS origins (staging, custom domains).
# CORS_ORIGINS=

# Optional JSON body size limit (default 8mb).
# JSON_BODY_LIMIT=8mb

# Optional global API rate limit per IP per 15 minutes (default 400).
# API_RATE_LIMIT_MAX=400

# Local API port (server.js). Not used on Netlify.
# API_PORT=3001

# ── Stripe (required for homeowner payments + contractor Connect on Netlify) ─
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Optional integrations (features degrade gracefully when unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=          — server geocoding + scan (Functions)
# VITE_GOOGLE_MAPS_API_KEY=     — Maps JavaScript API (contractor service-area map)
# SLACK_WEBHOOK_URL=
# N8N_WEBHOOK_URL=
# SENTRY_DSN=
# POSTHOG_API_KEY=
# MEDIA_STORAGE_MODE=inline

# ── Branding overrides (optional) ─────────────────────────────────────────────
# BRAND_PRODUCT_NAME=FixBridge
# BRAND_LEGAL_NAME=FixBridge
# BRAND_SUPPORT_EMAIL=support@fixbridge.example
# BRAND_PRIMARY_COLOR=#FF4D1C

# ── Netlify UI checklist (Site settings → Environment variables) ──────────────
# Required:
#   SESSION_SECRET          — long random string for JWT signing
#   NEON_DATABASE_URL       — Neon connection string (persistent DB)
# Build-time (Vite):
#   VITE_AUTH0_DOMAIN        — Auth0 tenant domain
#   VITE_AUTH0_CLIENT_ID     — Auth0 SPA client ID
#   AUTH0_DOMAIN             — same domain for API userinfo verification
# Legacy (optional):
#   VITE_GOOGLE_CLIENT_ID   — Google OAuth Web Client ID
# Optional AI (any one):
#   OPENAI_API_KEY / OPENROUTER_API_KEY / AI_API_KEY + AI_BASE_URL / GEMINI_API_KEY
#   AI_PROVIDER, AI_MODEL
# Optional payments:
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PUBLISHABLE_KEY
# Optional:
#   GOOGLE_CLIENT_ID        — alias for API token verification
#   APPLE_CLIENT_ID         — alias for Apple token verification
#   RESEND_API_KEY          — password-reset emails
#   FROM_EMAIL              — Resend from address
#   APP_URL                 — https://YOUR-SITE.netlify.app
